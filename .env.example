# Copy to .env and fill in to enable cross-device account sync via Supabase.
# See supabase/README.md for the full setup steps.
# Without these, the app runs entirely on local on-device storage.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. A web address that forwards /battle/<code> into the app, e.g.
# https://example.com. With it set, battle invites are shared as https links,
# which every messenger makes tappable. Without it the invite is an
# animequiz:// link, which opens the app but travels as plain text — the room
# code is sent alongside it either way.
EXPO_PUBLIC_BATTLE_LINK_BASE=
